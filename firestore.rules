// Regole di sicurezza di Firestore: girano sui server di Google, non sul telefono,
// quindi nessuno le può aggirare modificando l'app. Si incollano nella console di Firebase
// (Firestore Database → Regole → Pubblica).
//
// Chi è chi: ogni profilo è un utente con email <profilo>@example.com e il PIN come password.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function entrato()      { return request.auth != null; }
    function profilo()      { return request.auth.token.email.split('@')[0]; }
    function dm()           { return entrato() && profilo() == 'dm'; }

    // Quali schede appartengono a quale profilo. Rombosogliola gioca anche Ireena.
    function proprietario(scheda) {
      return entrato() && (
        profilo() == scheda ||
        (profilo() == 'rombosogliola' && scheda == 'ireena')
      );
    }

    // Schede: le leggono tutti quelli entrati; le scrive il proprietario o il DM.
    match /personaggi/{scheda} {
      allow read:  if entrato();
      allow write: if dm() || proprietario(scheda);
    }

    // Dati del master (mostri, PF veri dei nemici): solo il DM, né lettura né scrittura per gli altri.
    match /dm/{documento=**} {
      allow read, write: if dm();
    }

    // Scontro: lo vedono tutti quelli entrati, lo prepara e lo guida il master.
    // Un giocatore può solo far avanzare il turno di uno, e solo quando tocca a un suo personaggio.
    match /scontro/attuale {
      allow read: if entrato();
      allow write: if dm();
      allow update: if entrato()
        && resource.data.stato == 'in corso'
        && proprietario(resource.data.ordine[resource.data.turno].id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['turno', 'round'])
        && (
          (request.resource.data.turno == resource.data.turno + 1 && request.resource.data.round == resource.data.round) ||
          (request.resource.data.turno == 0 && request.resource.data.round == resource.data.round + 1
            && resource.data.turno == resource.data.ordine.size() - 1)
        );
    }

    // Tiri d'iniziativa: ognuno scrive solo il proprio (Rombosogliola anche quello di Ireena), il master tutti.
    match /scontro/attuale/tiri/{scheda} {
      allow read: if entrato();
      allow write: if dm() || proprietario(scheda);
    }

    // Attacchi dal telefono: il giocatore crea il proprio (stato "colpire") e, se il master ha scritto "colpito",
    // può solo aggiungere i danni. Esito e danni applicati li scrive il master.
    match /scontro/attuale/attacchi/{attacco} {
      allow read: if entrato();
      allow create: if dm() || (proprietario(request.resource.data.pg) && request.resource.data.stato == 'colpire');
      allow update: if dm() || (proprietario(resource.data.pg)
        && resource.data.stato == 'colpito' && request.resource.data.stato == 'danni'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stato', 'danni']));
      allow delete: if dm();
    }

    // Tutto il resto è chiuso.
    match /{tutto=**} {
      allow read, write: if false;
    }
  }
}
